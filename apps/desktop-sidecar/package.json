{
  "name": "@silksong-git/desktop-sidecar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "silksong-git-desktop-sidecar": "./dist/main.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "format": "tsx ../../scripts/format.ts apps/desktop-sidecar",
    "lint": "tsx ../../scripts/lint.ts apps/desktop-sidecar",
    "test": "pnpm run build && tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@silksong-git/history": "workspace:*",
    "@silksong-git/repo-session": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
