{
  "name": "@silksong-git/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tauri build --no-bundle",
    "dev": "tauri dev",
    "format": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "smoke:webkit": "tsx scripts/smoke-webkit.ts",
    "test": "pnpm --filter @silksong-git/desktop-sidecar build && cargo test --manifest-path src-tauri/Cargo.toml",
    "verify:web-assets": "tsx scripts/verify-web-assets.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "tsx": "4.22.4"
  }
}
