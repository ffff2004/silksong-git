{
  "name": "@silksong-git/cli",
  "version": "0.1.0",
  "description": "Local save history, semantic inspection, and restore tools for Hollow Knight: Silksong",
  "homepage": "https://github.com/ffff2004/silksong-git/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/ffff2004/silksong-git/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffff2004/silksong-git.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "silksong-git": "./dist/main.js",
    "ssgit": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "format": "tsx ../../scripts/format.ts apps/cli",
    "lint": "tsx ../../scripts/lint.ts apps/cli",
    "prepack": "pnpm run build",
    "preview": "node ./dist/main.js",
    "test": "pnpm run build && tsx --test src/**/*.test.ts",
    "verify-pack": "tsx scripts/verify-pack.ts"
  },
  "dependencies": {
    "@silksong-git/core": "^0.1.0",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@silksong-git/history": "^0.1.0",
    "@silksong-git/repo-session": "^0.1.0",
    "npm": "12.0.2",
    "tsup": "^8.5.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
