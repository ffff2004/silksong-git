{
  "name": "@silksong-git/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "silksong-git": "./dist/main.js",
    "ssgit": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "format": "tsx ../../scripts/format.ts apps/cli",
    "lint": "tsx ../../scripts/lint.ts apps/cli",
    "prepack": "pnpm run build",
    "preview": "node ./dist/main.js",
    "prototype:linux-sidecar": "tsx prototypes/linux-sidecar/run.ts",
    "test": "pnpm run build && tsx --test --test-reporter=dot src/**/*.test.ts",
    "verify-pack": "tsx scripts/verify-pack.ts"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@silksong-git/core": "workspace:*",
    "@silksong-git/history": "workspace:*",
    "postject": "1.0.0-alpha.6",
    "tsup": "^8.5.1"
  }
}
