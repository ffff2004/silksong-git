{
  "name": "@silksong-git/core",
  "version": "0.1.0",
  "description": "Browser-safe semantic decoding, mapping, snapshots, and diffs for Hollow Knight: Silksong saves",
  "homepage": "https://github.com/ffff2004/silksong-git/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ffff2004/silksong-git/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffff2004/silksong-git.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "fixtures:generate": "tsx src/decode/fixtures/generate-fixtures.ts",
    "format": "tsx ../../scripts/format.ts packages/core",
    "lint": "tsx ../../scripts/lint.ts packages/core",
    "prepack": "pnpm run build",
    "smoke:local-saves": "tsx src/decode/smoke-local-saves.ts",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "complete-common": "2.29.0",
    "crypto-js": "4.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/crypto-js": "4.2.2",
    "tsup": "^8.5.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
