{
  "name": "@silksong-git/history",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./http-contract": {
      "types": "./src/http-contract.ts",
      "default": "./src/http-contract.ts"
    }
  },
  "scripts": {
    "format": "tsx ../../scripts/format.ts packages/history",
    "generate:openapi": "tsx src/scripts/generate-openapi.ts",
    "lint": "tsx ../../scripts/lint.ts packages/history",
    "test": "tsx --test --test-reporter=dot src/**/*.test.ts",
    "test:verbose": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "@hono/zod-openapi": "^1.4.0",
    "@silksong-git/core": "workspace:*",
    "hono": "^4.12.29",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "prettier": "3.8.4"
  }
}
