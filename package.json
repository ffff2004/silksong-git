{
  "name": "silksong-git",
  "private": true,
  "homepage": "https://github.com/ffff2004/silksong-git#readme",
  "bugs": {
    "url": "https://github.com/ffff2004/silksong-git/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffff2004/silksong-git.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @silksong-git/cli... --filter @silksong-git/web... run build && pnpm build-desktop",
    "build:release-packages": "pnpm --filter @silksong-git/cli... run build",
    "build-cli": "pnpm --filter @silksong-git/cli... run build",
    "build-desktop": "pnpm --filter @silksong-git/desktop build",
    "build-desktop-sidecar": "pnpm --filter @silksong-git/desktop-sidecar build",
    "build-web": "pnpm --filter @silksong-git/web... run build",
    "check:release-packages": "tsx ./scripts/check-release-packages.ts",
    "dev-cli": "pnpm --filter @silksong-git/cli dev",
    "dev-desktop": "pnpm --filter @silksong-git/desktop dev",
    "dev-desktop-sidecar": "pnpm --filter @silksong-git/desktop-sidecar dev",
    "dev-web": "pnpm --filter @silksong-git/web dev",
    "format": "tsx ./scripts/format.ts",
    "generate:openapi": "pnpm --filter @silksong-git/repo-session generate:openapi",
    "lint": "tsx ./scripts/lint.ts && pnpm --filter @silksong-git/desktop lint",
    "local-release": "pnpm verify-cli-pack",
    "pack-cli": "pnpm --filter @silksong-git/cli pack",
    "preview-cli": "pnpm --filter @silksong-git/cli preview",
    "preview-web": "pnpm --filter @silksong-git/web preview",
    "prototype:linux-sidecar-static-git": "tsx apps/desktop-sidecar/prototypes/linux-x64-static-git/run.ts",
    "qualify-git": "tsx ./scripts/qualify-git.ts",
    "test": "pnpm --recursive --if-present run test",
    "validate:agent": "pnpm format && pnpm verify:agent",
    "verify": "tsx ./scripts/verify.ts --reporter=human",
    "verify:agent": "tsx ./scripts/verify.ts --reporter=agent",
    "verify-cli-pack": "pnpm build:release-packages && pnpm verify-cli-pack:built",
    "verify-cli-pack:built": "pnpm check:release-packages && pnpm --filter @silksong-git/cli verify-pack"
  },
  "devDependencies": {
    "@eslint/json": "2.0.0",
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "26.0.0",
    "@types/semver": "7.7.1",
    "ajv-cli": "5.0.0",
    "ajv-formats": "3.0.1",
    "complete-common": "2.29.0",
    "complete-lint": "5.20.0",
    "complete-node": "17.0.0",
    "complete-tsconfig": "1.7.0",
    "diff": "9.0.0",
    "eslint": "10.5.0",
    "eslint-config-complete": "4.16.0",
    "knip": "6.17.1",
    "postject": "1.0.0-alpha.6",
    "prettier": "3.8.4",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "semver": "7.8.5",
    "stylelint": "17.13.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.9.0",
  "knip": {
    "workspaces": {
      "apps/web": {
        "entry": [
          "src/main.tsx",
          "src/desktop-main.tsx"
        ]
      }
    }
  }
}
