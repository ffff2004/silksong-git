{
  "name": "silksong-tracker",
  "private": true,
  "homepage": "https://github.com/th3r3dfox/silksong-tracker#readme",
  "bugs": {
    "url": "https://github.com/th3r3dfox/silksong-tracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/th3r3dfox/silksong-tracker.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @silksong-tracker/web build",
    "format": "tsx ./scripts/format.ts",
    "lint": "tsx ./scripts/lint.ts",
    "preview": "pnpm --filter @silksong-tracker/web preview",
    "start": "pnpm --filter @silksong-tracker/web start"
  },
  "devDependencies": {
    "@eslint/json": "2.0.0",
    "ajv-cli": "5.0.0",
    "ajv-formats": "3.0.1",
    "complete-common": "2.29.0",
    "complete-lint": "5.20.0",
    "complete-node": "17.0.0",
    "complete-tsconfig": "1.7.0",
    "eslint": "10.5.0",
    "eslint-config-complete": "4.16.0",
    "globby": "16.2.0",
    "stylelint": "17.13.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
